      ],
      "parameters": {
        "jsCode": "const workflows = $('Fetch Data').all().flatMap(it => it.json.data ?? [it.json]);\nconst summary = $('Parse AI Output').first().json.backup_summary ?? 'n8n backup';\nconst sha = $input.first().json.sha;\nreturn [{ json: { message: 'n8n backup: ' + summary.slice(0, 60), content: Buffer.from(JSON.stringify(workflows, null, 2)).toString('base64'), ...(sha ? { sha } : {}) } }];"
      }
    },
    {
      "id": "727b6796-f49a-4802-9eac-408e67cf1142",
      "name": "Commit Backup to GitHub 2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        420
      ],
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.githubOwner }}/{{ $('Config').first().json.githubRepo }}/contents/{{ $('Config').first().json.backupPath }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "68334264-e6ba-464b-a48b-232ae3cabce6",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 520,
        "height": 460,
        "color": 4,
        "content": "## 47 · AI Backup Automation\nNightly exports every n8n workflow via the n8n API to a GitHub repo and has AI summarise what changed.\n\n**Trigger:** schedule `0 2 * * *`\n\n**Setup**\n1. Edit the **Config** node (model, sheet URL, endpoints).\n2. Connect credentials: GitHub API, Header Auth (X-N8N-API-KEY), OpenAI API, Slack.\n3. Pick Slack channels / sheet tabs on the action nodes.\n4. Activate."
      }
    }
  ],
