    },
    {
      "id": "d06febd2-fcad-4852-a630-a99668dd5515",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "ba1ca7aa-f191-4c0d-adf9-f1462a002918",
              "name": "model",
              "value": "gpt-4o-mini",
              "type": "string"
            },
            {
              "id": "cc7a4961-b5b3-4247-9a39-c699b73e16ae",
              "name": "spreadsheetUrl",
              "value": "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit",
              "type": "string"
            },
            {
              "id": "19715e63-e95e-4c51-b4ee-d1586003ec8f",
              "name": "adsMetricsUrl",
              "value": "https://api.your-ads-reporting.com/campaigns/yesterday",
              "type": "string"
            },
            {
              "id": "f8f5e693-bca4-4f50-b988-a91ec10734e4",
              "name": "target_cpa",
              "value": "50",
              "type": "string"
            },
            {
              "id": "8778ddfe-6bdd-4335-8819-17d5f1ae3cb9",
              "name": "target_roas",
              "value": "3",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "6a7752e6-ae46-45a7-9b77-e700c6d32d6f",
      "name": "Fetch Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "url": "={{ $('Config').first().json.adsMetricsUrl }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "467d2666-7f34-40b2-9df6-1d797c7a2eac",
      "name": "Prepare AI Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "// Packs the incoming data, the current time and relevant settings into one prompt string per item.\nconst items = $input.all();\nconst cfg = $('Config').first().json;\nconst settings = Object.fromEntries([\"target_cpa\",\"target_roas\"].map(k => [k, cfg[k]]));\nconst MAX = 15000;\nconst clip = s => (s.length > MAX ? s.slice(0, MAX) + ' ...[truncated]' : s);\nconst stripHtml = h => String(h ?? '').replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst it0 = arr => arr[0]?.json ?? {};\nconst packed = [{ input: { records: items.map(it => it.json) }, i: 0 }];\nreturn packed.map(({ input, i }) => ({\n  json: { aiInput: clip(JSON.stringify({ now: new Date().toISOString(), settings, input })) },\n  pairedItem: { item: i },\n}));"
      }
    },
    {
      "id": "39180f5c-9c61-40fc-a14f-65340b2164a9",
      "name": "AI Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"You are a performance-marketing analyst. From yesterday campaign metrics (spend, impressions, clicks, conversions, revenue) vs targets (target_cpa, target_roas from config), find underperforming campaigns, anomalies and recommend budget reallocations.\\n\\nRespond ONLY with a valid JSON object with exactly these keys: summary, total_spend (number), roas (number), alerts (array), recommendations (array), needs_attention (boolean). Use null for unknown values.\" }, { role: 'user', content: $json.aiInput } ] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "456705de-2cee-4aeb-a727-9343fc5a8a1c",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  let out;\n  try { out = JSON.parse(item.json.choices[0].message.content); }\n  catch (e) { out = { parse_error: true, raw: item.json?.choices?.[0]?.message?.content ?? item.json }; }\n  return { json: { ...out, processed_at: new Date().toISOString() }, pairedItem: { item: i } };\n});"
      }
    },
    {
      "id": "74653981-2a25-45d5-8d59-b955f9b80039",
      "name": "If needs_attention is true",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "d4eebad4-160b-45d4-9526-5eee183acda8",
              "leftValue": "={{ $json.needs_attention }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "0a52c6c9-79ee-445e-8155-85b5747bd975",
      "name": "Slack #paid-media",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1680,
        180
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#paid-media"
        },
        "text": "=:chart_with_downwards_trend: Ads need attention. ROAS {{ $json.roas }} on {{ $json.total_spend }} spend\nAlerts: {{ $json.alerts }}\nDo: {{ $json.recommendations }}",
        "otherOptions": {}
      }
    },
    {
      "id": "03070b84-3b55-4550-96ec-e55d67d695f4",
      "name": "Flatten Row (Ad Performance)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "// Google Sheets cells can't hold arrays/objects - stringify them.\nreturn $input.all().map((it, i) => ({\n  json: Object.fromEntries(Object.entries(it.json).map(([k, v]) => [k, v !== null && typeof v === 'object' ? JSON.stringify(v) : v])),\n  pairedItem: { item: i },\n}));"
      }
    },
