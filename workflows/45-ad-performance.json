{
  "name": "45 - AI Ad Performance Monitor",
  "nodes": [
    {
      "id": "12f73635-5926-4e86-bfa5-f4f2015438d8",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
