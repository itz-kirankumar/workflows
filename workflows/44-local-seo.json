{
  "name": "44 - AI Local SEO Monitor",
  "nodes": [
    {
      "id": "2ba3a9e2-06bb-4bb9-a0f3-90d026552ed0",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "29f36f36-fd12-48b3-9be7-9a44f26b89aa",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "f29f48d5-72f2-486e-bd44-f4de6f3577fd",
              "name": "model",
              "value": "gpt-4o-mini",
              "type": "string"
            },
            {
              "id": "aae44b2a-35e1-4e06-84e5-3b5cc688998d",
              "name": "spreadsheetUrl",
              "value": "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit",
              "type": "string"
            },
            {
              "id": "565ba76c-20c2-4ac6-b02f-cec99ecdbd1e",
              "name": "pagesToAudit",
              "value": "https://your-business.com/",
              "type": "string"
            },
            {
              "id": "8efb4c0c-8c93-4035-883d-fd74a449f177",
              "name": "businessName",
              "value": "Your Business",
              "type": "string"
            },
            {
              "id": "05c97fe1-8764-4436-9334-6e1ef9cee66a",
              "name": "businessAddress",
              "value": "123 Main St, City",
              "type": "string"
            },
            {
              "id": "a39eafc9-7925-44e9-a75b-37ecec69dd32",
              "name": "businessPhone",
              "value": "+91 00000 00000",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "235c070a-4ff1-4ddb-ba6c-3b1ad8a3b22c",
      "name": "Split URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "return $('Config').first().json.pagesToAudit.split(',').map(u => u.trim()).filter(Boolean).map(url => ({ json: { url } }));"
      }
    },
    {
      "id": "228a4115-1231-45f7-8129-c3ff9acd230e",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      }
    },
    {
      "id": "1d9ba2fd-e541-45fb-924a-78c63fb8b4b6",
      "name": "Prepare AI Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "// Packs the incoming data, the current time and relevant settings into one prompt string per item.\nconst items = $input.all();\nconst cfg = $('Config').first().json;\nconst settings = Object.fromEntries([\"pagesToAudit\",\"businessName\",\"businessAddress\",\"businessPhone\"].map(k => [k, cfg[k]]));\nconst MAX = 15000;\nconst clip = s => (s.length > MAX ? s.slice(0, MAX) + ' ...[truncated]' : s);\nconst stripHtml = h => String(h ?? '').replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst it0 = arr => arr[0]?.json ?? {};\nconst packed = items.map((it, i) => ({ input: { url: $('Split URLs').all()[i]?.json.url, page_text: stripHtml(it.json.html) }, i }));\nreturn packed.map(({ input, i }) => ({\n  json: { aiInput: clip(JSON.stringify({ now: new Date().toISOString(), settings, input })) },\n  pairedItem: { item: i },\n}));"
      }
    },
    {
      "id": "b52ef821-8307-44b0-bd7f-7804e2602959",
      "name": "AI Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"You are a local SEO specialist. Audit the page HTML for: NAP (name, address, phone) consistency with the config business details, LocalBusiness schema, title/meta with city keywords, Google Maps embed, review mentions, mobile signals. Score 0-100 and list prioritised fixes.\\n\\nRespond ONLY with a valid JSON object with exactly these keys: url, score (0-100), nap_consistent (boolean), issues (array), top_fixes (array). Use null for unknown values.\" }, { role: 'user', content: $json.aiInput } ] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "6826de9f-66ae-4968-95d7-8e7a13e345a1",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  let out;\n  try { out = JSON.parse(item.json.choices[0].message.content); }\n  catch (e) { out = { parse_error: true, raw: item.json?.choices?.[0]?.message?.content ?? item.json }; }\n  return { json: { ...out, processed_at: new Date().toISOString() }, pairedItem: { item: i } };\n});"
      }
    },
    {
      "id": "8fa93a5c-ed99-4011-8dbc-ef3c773d7af0",
      "name": "If score <= 70",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1d19d656-b5a2-40ca-9b49-39004a174a60",
              "leftValue": "={{ $json.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "02f8ffab-9708-4f0b-930a-e062c2e0ca6e",
      "name": "Slack #seo",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1920,
        180
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#seo"
        },
        "text": "=:round_pushpin: Local SEO score {{ $json.score }} for {{ $json.url }}\nTop fixes: {{ $json.top_fixes }}",
        "otherOptions": {}
      }
    },
    {
      "id": "a39f2659-188c-4925-9208-5407231935c1",
      "name": "Flatten Row (Local SEO)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "// Google Sheets cells can't hold arrays/objects - stringify them.\nreturn $input.all().map((it, i) => ({\n  json: Object.fromEntries(Object.entries(it.json).map(([k, v]) => [k, v !== null && typeof v === 'object' ? JSON.stringify(v) : v])),\n  pairedItem: { item: i },\n}));"
      }
    },
