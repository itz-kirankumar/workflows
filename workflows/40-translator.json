      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#localization"
        },
        "text": "=:globe_with_meridians: Translation needs review ({{ $json.confidence }}): {{ $json.reviewer_notes }}",
        "otherOptions": {}
      }
    },
    {
      "id": "dd4833f1-87bb-4865-867d-ef118c5de006",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 520,
        "height": 460,
        "color": 4,
        "content": "## 40 · AI Language Translator\nTranslates text into one or more target languages preserving tone and formatting, with a quality self-check.\n\n**Trigger:** `POST /webhook/translator` (JSON body)\n\n**Setup**\n1. Edit the **Config** node (model, sheet URL, endpoints).\n2. Connect credentials: OpenAI API, Slack.\n3. Pick Slack channels / sheet tabs on the action nodes.\n4. Activate.\n\n**Sample payload:**\n```json\n{\n \"text\": \"Your order has shipped and will arrive in 2 days.\",\n \"target_languages\": [\n  \"hi\",\n  \"ta\",\n  \"es\"\n ]\n}\n```"
      }
    }
  ],
