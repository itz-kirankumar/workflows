{
  "name": "19 - AI Inventory Monitor",
  "nodes": [
    {
      "id": "b8b2e567-b49a-41f8-ba79-c035054a71ce",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "4c91874d-04fa-4a04-977c-7905940c0893",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "e7d178e7-a569-47f0-a47f-2e10a0690ca7",
              "name": "model",
              "value": "gpt-4o-mini",
              "type": "string"
            },
            {
              "id": "f71fb053-6229-4a39-9147-6edeafbf7c31",
              "name": "spreadsheetUrl",
              "value": "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "609faf0f-8820-4310-bca4-b776e76211e6",
      "name": "Fetch Data",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Config').first().json.spreadsheetUrl }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Inventory"
        },
        "options": {}
      }
    },
    {
      "id": "d49f48cd-89df-4897-baa5-d9259f036012",
      "name": "Prepare AI Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "// Packs the incoming data, the current time and relevant settings into one prompt string per item.\nconst items = $input.all();\nconst cfg = $('Config').first().json;\nconst settings = Object.fromEntries([].map(k => [k, cfg[k]]));\nconst MAX = 15000;\nconst clip = s => (s.length > MAX ? s.slice(0, MAX) + ' ...[truncated]' : s);\nconst stripHtml = h => String(h ?? '').replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst it0 = arr => arr[0]?.json ?? {};\nconst packed = items.map((it, i) => ({ input: it.json, i }));\nreturn packed.map(({ input, i }) => ({\n  json: { aiInput: clip(JSON.stringify({ now: new Date().toISOString(), settings, input })) },\n  pairedItem: { item: i },\n}));"
      }
    },
    {
      "id": "793e8298-54c6-4aa3-a877-572cfd9ff876",
      "name": "AI Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"You are an inventory planner. For the SKU row (on_hand, daily_sales_avg, lead_time_days, safety_stock), compute days_of_cover and whether to reorder now; recommend an order quantity covering lead time + 30 days.\\n\\nRespond ONLY with a valid JSON object with exactly these keys: sku, product, on_hand (number), days_of_cover (number), reorder (boolean), reorder_qty (number), reason. Use null for unknown values.\" }, { role: 'user', content: $json.aiInput } ] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "a20f9304-69c3-4d17-ad5b-4600db1ef0a0",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  let out;\n  try { out = JSON.parse(item.json.choices[0].message.content); }\n  catch (e) { out = { parse_error: true, raw: item.json?.choices?.[0]?.message?.content ?? item.json }; }\n  return { json: { ...out, processed_at: new Date().toISOString() }, pairedItem: { item: i } };\n});"
      }
    },
    {
      "id": "3a1a9734-6285-4c62-b253-f41812d88233",
      "name": "If reorder is true",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "8a9d549e-f21d-4a05-ac9e-a491cb25aee3",
              "leftValue": "={{ $json.reorder }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "1ee91014-3eba-4d67-a757-43d3443f395c",
      "name": "Slack #inventory",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1680,
        180
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#inventory"
        },
        "text": "=:package: Reorder {{ $json.reorder_qty }} x {{ $json.product }} ({{ $json.sku }}) - {{ $json.days_of_cover }} days of cover left.",
        "otherOptions": {}
      }
    },
    {
      "id": "c410e70d-86cb-4521-aa06-6f080a39dca0",
      "name": "Flatten Row (Reorder Requests)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "// Google Sheets cells can't hold arrays/objects - stringify them.\nreturn $input.all().map((it, i) => ({\n  json: Object.fromEntries(Object.entries(it.json).map(([k, v]) => [k, v !== null && typeof v === 'object' ? JSON.stringify(v) : v])),\n  pairedItem: { item: i },\n}));"
      }
    },
    {
      "id": "3c28692f-ec59-4894-9f77-08a6b8055130",
      "name": "Log to Reorder Requests",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Config').first().json.spreadsheetUrl }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Reorder Requests"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "2ac26a07-9076-4ef7-8707-a191206484b7",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 520,
        "height": 460,
        "color": 4,
        "content": "## 19 · AI Inventory Monitor\nChecks stock levels every 6 hours, predicts stock-out dates from sales velocity and recommends reorder quantities.\n\n**Trigger:** schedule `0 */6 * * *`\n\n**Setup**\n1. Edit the **Config** node (model, sheet URL, endpoints).\n2. Connect credentials: Google Sheets OAuth2, OpenAI API, Slack.\n3. Pick Slack channels / sheet tabs on the action nodes.\n4. Activate."
      }
    }
  ],
