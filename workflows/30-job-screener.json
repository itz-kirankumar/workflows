            {
              "id": "9ff30ce5-fa39-44f9-9328-f3cc9844c034",
              "leftValue": "={{ $json.fit_score }}",
              "rightValue": 75,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
