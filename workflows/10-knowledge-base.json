      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "9da4368a-9429-4dee-9437-a99ea6ace775",
