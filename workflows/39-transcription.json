        "path": "transcription",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "ee929f83-8d07-4e13-a3a3-efc9feab20a3",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "62169ab9-39e7-48af-ad44-37383a526829",
              "name": "model",
