{
  "name": "39 - AI Transcription Automation",
  "nodes": [
    {
      "id": "97d2dccd-2139-47ed-a424-a355cb7541c0",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
