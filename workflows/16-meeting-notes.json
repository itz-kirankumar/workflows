    {
      "id": "d7d22c69-7289-4e5a-98a9-52c37dd57e18",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "c9f15fa0-9123-469b-9b19-8fb7ed345535",
