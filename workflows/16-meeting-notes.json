      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "4587d232-f837-4ddd-b077-a0263dbbdce1",
              "leftValue": "={{ $json.action_count }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "30f5618d-5def-4b2b-86fd-da9710fc7dca",
      "name": "Slack #meetings",
