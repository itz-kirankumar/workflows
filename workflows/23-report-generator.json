      ],
      "parameters": {
        "sendTo": "={{ $('Config').first().json.reportRecipients }}",
        "subject": "={{ $json.title }}",
        "emailType": "text",
        "message": "={{ $json.report_markdown }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "2d833537-40c1-43bb-8930-4be1d870573f",
      "name": "Send Email 2",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1680,
