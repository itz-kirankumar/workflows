{
  "name": "23 - AI Report Generator",
  "nodes": [
    {
      "id": "9f1ef8e9-545f-4fa4-b2c1-32e1d6149814",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "8890cbf0-70d3-47d1-8bcc-4e6dbac0228d",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "8cfb2ab6-53de-43fa-84d0-cd83339735a2",
              "name": "model",
              "value": "gpt-4o-mini",
              "type": "string"
            },
            {
              "id": "e6e46edc-4091-4e6d-8b55-26620cf37453",
              "name": "metricsUrl",
              "value": "https://api.your-company.com/metrics/weekly",
              "type": "string"
            },
            {
              "id": "b922ff80-14bd-4343-aed9-6f01fe0f46ae",
              "name": "reportRecipients",
              "value": "team@example.com",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "1a9f84f6-b2dd-4b82-8656-6e6057a249b4",
      "name": "Fetch Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "url": "={{ $('Config').first().json.metricsUrl }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "0cb325ed-4cf5-43ce-9a13-c8e1dd8be54d",
      "name": "Prepare AI Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "// Packs the incoming data, the current time and relevant settings into one prompt string per item.\nconst items = $input.all();\nconst cfg = $('Config').first().json;\nconst settings = Object.fromEntries([\"reportRecipients\"].map(k => [k, cfg[k]]));\nconst MAX = 15000;\nconst clip = s => (s.length > MAX ? s.slice(0, MAX) + ' ...[truncated]' : s);\nconst stripHtml = h => String(h ?? '').replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst it0 = arr => arr[0]?.json ?? {};\nconst packed = [{ input: { records: items.map(it => it.json) }, i: 0 }];\nreturn packed.map(({ input, i }) => ({\n  json: { aiInput: clip(JSON.stringify({ now: new Date().toISOString(), settings, input })) },\n  pairedItem: { item: i },\n}));"
      }
    },
    {
      "id": "3c0c1319-c1d2-43d6-8fee-35b570fd5d40",
      "name": "AI Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"You are a business analyst. Write a weekly executive report from the metrics: headline KPIs with week-over-week change, 3 highlights, 3 risks, and recommended actions. Use markdown.\\n\\nRespond ONLY with a valid JSON object with exactly these keys: title, report_markdown, kpi_health (\\\"good\\\"|\\\"mixed\\\"|\\\"bad\\\"). Use null for unknown values.\" }, { role: 'user', content: $json.aiInput } ] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "c332a0cb-6ab4-4660-ace6-fb4186bbc3f5",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  let out;\n  try { out = JSON.parse(item.json.choices[0].message.content); }\n  catch (e) { out = { parse_error: true, raw: item.json?.choices?.[0]?.message?.content ?? item.json }; }\n  return { json: { ...out, processed_at: new Date().toISOString() }, pairedItem: { item: i } };\n});"
      }
    },
    {
      "id": "aa549d1e-64b0-4cf8-80fb-959bc80dd327",
      "name": "If kpi_health = bad",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b523bc2b-c1fb-4564-afcf-cda430a59036",
              "leftValue": "={{ $json.kpi_health }}",
              "rightValue": "bad",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "7775768f-4108-4c20-9a13-7af9eb5e73aa",
      "name": "Slack #leadership",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1680,
        180
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#leadership"
        },
        "text": "=:red_circle: Weekly report flagged problems\n{{ $json.report_markdown }}",
        "otherOptions": {}
      }
    },
    {
      "id": "2b5ff98d-e446-4087-830f-adb86dfa1414",
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1680,
