{
  "name": "42 - AI Competitor Monitor",
  "nodes": [
    {
      "id": "89f4ac60-494f-4843-80d5-202667fd7315",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "7d6c6323-e8ef-4d3f-bf39-6a4bbe46f27b",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "include": "all",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "83081d5f-6665-417f-aef4-5820783c62ae",
              "name": "model",
              "value": "gpt-4o-mini",
              "type": "string"
            },
            {
              "id": "20c2d3ef-0e40-4b10-8da7-7ca8bf830d2c",
              "name": "spreadsheetUrl",
              "value": "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit",
              "type": "string"
            },
            {
              "id": "22ae8152-55c5-4d07-9c78-603c83079578",
              "name": "competitorUrls",
              "value": "https://competitor-a.com/pricing,https://competitor-b.com/pricing",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "2f9e8ffa-05e3-43f2-98e9-202198a8ea68",
      "name": "Split URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "return $('Config').first().json.competitorUrls.split(',').map(u => u.trim()).filter(Boolean).map(url => ({ json: { url } }));"
      }
    },
    {
      "id": "8b5a6cf0-c4a5-49c6-b678-2f484d7b25ad",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      }
    },
    {
      "id": "6af2ee0c-fb35-42d9-9cd1-62276100a376",
      "name": "Prepare AI Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "// Packs the incoming data, the current time and relevant settings into one prompt string per item.\nconst items = $input.all();\nconst cfg = $('Config').first().json;\nconst settings = Object.fromEntries([].map(k => [k, cfg[k]]));\nconst MAX = 15000;\nconst clip = s => (s.length > MAX ? s.slice(0, MAX) + ' ...[truncated]' : s);\nconst stripHtml = h => String(h ?? '').replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst it0 = arr => arr[0]?.json ?? {};\nconst packed = items.map((it, i) => ({ input: { url: $('Split URLs').all()[i]?.json.url, page_text: stripHtml(it.json.html) }, i }));\nreturn packed.map(({ input, i }) => ({\n  json: { aiInput: clip(JSON.stringify({ now: new Date().toISOString(), settings, input })) },\n  pairedItem: { item: i },\n}));"
      }
    },
    {
      "id": "d35f281a-b4cc-4a6f-9dbf-fcc4a8e5f326",
      "name": "AI Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"You are a competitive-intelligence analyst. Compare the current page content to previous_snapshot (if present). Report meaningful changes only: pricing, new features, positioning, launches, hiring signals. Rate significance 0-10.\\n\\nRespond ONLY with a valid JSON object with exactly these keys: competitor, url, changes (array), significance (0-10), summary, snapshot (short text fingerprint of key facts). Use null for unknown values.\" }, { role: 'user', content: $json.aiInput } ] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "79036841-86a5-424c-9d77-b723e9cc3de4",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  let out;\n  try { out = JSON.parse(item.json.choices[0].message.content); }\n  catch (e) { out = { parse_error: true, raw: item.json?.choices?.[0]?.message?.content ?? item.json }; }\n  return { json: { ...out, processed_at: new Date().toISOString() }, pairedItem: { item: i } };\n});"
      }
    },
    {
      "id": "cae438ce-0254-4501-beda-95aa86f1fc5b",
      "name": "If significance >= 5",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "41354a7c-2e38-4d99-8df5-f06ed20dce89",
              "leftValue": "={{ $json.significance }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "3d972a95-11b2-4dca-abc2-c5a55c19f2e3",
      "name": "Slack #competitive-intel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1920,
        180
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#competitive-intel"
        },
        "text": "=:eyes: {{ $json.competitor }} changed ({{ $json.significance }}/10): {{ $json.summary }}",
        "otherOptions": {}
      }
    },
    {
      "id": "80f4f164-8579-4c8f-b555-705e3bbbddd9",
      "name": "Flatten Row (Competitor Snapshots)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "// Google Sheets cells can't hold arrays/objects - stringify them.\nreturn $input.all().map((it, i) => ({\n  json: Object.fromEntries(Object.entries(it.json).map(([k, v]) => [k, v !== null && typeof v === 'object' ? JSON.stringify(v) : v])),\n  pairedItem: { item: i },\n}));"
      }
    },
    {
      "id": "339ddd0d-1d99-4bb8-bc3f-ddc934f9fe9f",
      "name": "Log to Competitor Snapshots",
