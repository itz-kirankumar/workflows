    },
    {
      "id": "2ddf2abc-0c06-4536-9a5d-93952fb2a127",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 520,
        "height": 460,
        "color": 4,
        "content": "## 36 · AI Project Status Reporter\nEvery Friday pulls tasks from your PM tool API and writes a RAG-status project report for stakeholders.\n\n**Trigger:** schedule `0 15 * * 5`\n\n**Setup**\n1. Edit the **Config** node (model, sheet URL, endpoints).\n2. Connect credentials: Gmail OAuth2, OpenAI API, Slack.\n3. Pick Slack channels / sheet tabs on the action nodes.\n4. Activate."
      }
    }
