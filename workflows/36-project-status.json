{
  "name": "36 - AI Project Status Reporter",
  "nodes": [
    {
      "id": "370f003a-00a7-458b-b340-7a96741a46ac",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
