          "conditions": [
            {
              "id": "30699993-45b5-4edb-9343-3814aebbc176",
              "leftValue": "={{ $json.risk_score }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
